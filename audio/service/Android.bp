// Fork of hardware/mediatek/hidl/audio: this device ships neither the
// soundtrigger3 AIDL impl nor the MediaTek audio AIDL impl, so those (and the
// HIDL sound trigger) are registered only when present.
cc_binary {
    name: "android.hardware.audio.service.sycamore",

    init_rc: ["android.hardware.audio.service.sycamore.rc"],
    relative_install_path: "hw",
    vendor: true,

    srcs: ["service.cpp"],

    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],

    shared_libs: [
        "libcutils",
        "libbinder",
        "libbinder_ndk",
        "libhidlbase",
        "liblog",
        "libutils",
        "libhardware",
        "android.hardware.soundtrigger3-V1-ndk",
        "vendor.mediatek.hardware.audio-V1-ndk",
    ],
}
