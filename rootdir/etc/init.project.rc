import /vendor/etc/init/hw/init.mtkgki.rc

# MTK project .rc configure

on init
    mkdir /mnt/media_rw/usbotg 0700 media_rw media_rw
    mkdir /storage/usbotg 0700 root root
    mkdir /mnt/vendor/persist 0777 system system
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist rw noatime wait

on post-fs-data

#Camera
    chmod 0660 /dev/MAINAF
    chown system camera /dev/MAINAF

    chmod 0660 /dev/MAINAF2
    chown system camera /dev/MAINAF2

    chmod 0660 /dev/SUBAF
    chown system camera /dev/SUBAF

    chmod 0660 /dev/GAF001AF
    chown system camera /dev/GAF001AF

    chmod 0660 /dev/DW9714AF
    chown system camera /dev/DW9714AF

    chmod 0660 /dev/LC898212AF
    chown system camera /dev/LC898212AF

    chmod 0660 /dev/BU64745GWZAF
    chown system camera /dev/BU64745GWZAF

#SMB
    chown system system /proc/smb/ScreenComm
    chmod 0660 /proc/smb/ScreenComm

    chmod 0660 /dev/spm
    chown system system /dev/spm

# Sycamore code for SYCAMORE-2574 by zhourh6 at 2025/02/10 start
    chown system system /mnt/vendor/persist
    chmod 0777 /mnt/vendor/persist
    restorecon_recursive /mnt/vendor/persist
    mkdir /mnt/vendor/persist/mtk_battery_cmd
    chown root system  /mnt/vendor/persist/mtk_battery_cmd/nuovo_flag
    chmod 0755 /mnt/vendor/persist/mtk_battery_cmd/nuovo_flag
# Sycamore code for SYCAMORE-2574 by zhourh6 at 2025/02/10 end

# Sycamore code for SYCAMORE-2574 by zhourh6 at 2025/02/10 start
on property:persist.vendor.battery.nuovo_flag.enabled=1
    write /mnt/vendor/persist/mtk_battery_cmd/nuovo_flag 1
on property:persist.vendor.battery.nuovo_flag.enabled=0
    write /mnt/vendor/persist/mtk_battery_cmd/nuovo_flag 0
# Sycamore code for SYCAMORE-2574 by zhourh6 at 2025/02/10 end

on init
    # Refer to http://source.android.com/devices/tech/storage/index.html
    # It said, "Starting in Android 4.4, multiple external storage devices are surfaced to developers through
    #           Context.getExternalFilesDirs(), Context.getExternalCacheDirs(), and Context.getObbDirs().
    #           External storage devices surfaced through these APIs must be a semi-permanent part of the device (such as an SD card slot in a battery compartment).
    #           Developers expect data stored in these locations to be available over long periods of time."
    # Therefore, if the target doesn't support sd hot-plugging (Ex: the SD card slot in a battery compartment), we need to export SECONDARY_STORAGE in 'boot' section
    #
    # export SECONDARY_STORAGE /storage/sdcard1

service fuse_usbotg /system/bin/sdcard -u 1023 -g 1023 -w 1023 -d /mnt/media_rw/usbotg /storage/usbotg
    class late_start
    disabled

# start mmstat
on property:sys.boot_completed=1
    mkdir /sys/kernel/tracing/instances/mmstat 711
    write /sys/kernel/tracing/instances/mmstat/tracing_on 0
    write /sys/kernel/tracing/instances/mmstat/buffer_size_kb 16
    write /sys/kernel/tracing/instances/mmstat/events/mmstat/enable 1
    write /sys/kernel/tracing/instances/mmstat/tracing_on 1
# sycamore code for SYCAMORE-4312 by kexinzhang2 at  2024.11.26 start
    # System server manages zram writeback limits
    chown root system /sys/block/zram0/writeback_limit
    chmod 0664 /sys/block/zram0/writeback_limit
    chown root system /sys/block/zram0/writeback_limit_enable
    chmod 0664 /sys/block/zram0/writeback_limit_enable

    # System server trigger extend reclaim
    chown root system /sys/kernel/extend_reclaim/reclaim
    chmod 0664 /sys/kernel/extend_reclaim/reclaim

    trigger swapon_zram

on swapon_zram
    swapon_all /vendor/etc/fstab.default
# sycamore code for SYCAMORE-4312 by kexinzhang2 at  2024.11.26 end

# Sycamore code for SYCAMORE-378 by zengzc1 at 20241204
#performance
    chown system system /sys/class/thermal/thermal_zone24/temp
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/scaling_available_frequencies
    chown system system /sys/devices/system/cpu/cpu6/cpufreq/scaling_available_frequencies
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq
    chown system system /sys/devices/system/cpu/cpu6/cpufreq/scaling_cur_freq

#Sycamore code for SYCAMORE-4446 by zenghui4 at 2024.12.05 start
# pen
on property:sys.boot_completed=1
    chmod 0444 /dev/lenovo_penraw
#Sycamore code for SYCAMORE-4446 by zenghui4 at 2024.12.05 end

on property:sys.boot_completed=1
    # System server manages zram writeback limits
    chown root system /sys/block/zram0/writeback_limit
    chmod 0664 /sys/block/zram0/writeback_limit
    chown root system /sys/block/zram0/writeback_limit_enable
    chmod 0664 /sys/block/zram0/writeback_limit_enable
    # System server trigger extend reclaim
    chown root system /sys/kernel/extend_reclaim/reclaim
    chmod 0664 /sys/kernel/extend_reclaim/reclaim
    trigger swapon_zram
on swapon_zram
    swapon_all /vendor/etc/fstab.default
