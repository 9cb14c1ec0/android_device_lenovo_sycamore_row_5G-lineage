# Lenovo dynamicdata selects the userdata fstab (userdata or dm-userdata) at
# early-init by setting vendor.storage.dynamicdata.type. Ported from stock
# vendor policy; formatting helpers for the dm layout are omitted.
type dynamicdata, domain;
type dynamicdata_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(dynamicdata)

vendor_internal_prop(vendor_dynamicdata_prop)
set_prop(dynamicdata, vendor_dynamicdata_prop)

allow dynamicdata self:capability sys_admin;
allow dynamicdata kmsg_device:chr_file rw_file_perms;
allow dynamicdata devpts:chr_file rw_file_perms;
allow dynamicdata block_device:dir { write add_name search };
allow dynamicdata block_device:lnk_file { create unlink };
allow dynamicdata userdata_block_device:blk_file { ioctl read write getattr open };
allowxperm dynamicdata userdata_block_device:blk_file ioctl { 0x125e 0x1277 0x127b-0x127d };
allow dynamicdata cache_block_device:blk_file getattr;
allow dynamicdata dm_device:chr_file { ioctl read write open };
allow dynamicdata dm_device:blk_file { ioctl read write getattr open };
allow dynamicdata vendor_file:file read;
allow dynamicdata proc_swaps:file r_file_perms;
allow dynamicdata proc_cmdline:file r_file_perms;
allow dynamicdata proc_bootconfig:file r_file_perms;
allow dynamicdata sysfs_fs_ext4_features:dir search;
allow dynamicdata sysfs_fs_ext4_features:file r_file_perms;
allow dynamicdata sysfs_dt_firmware_android:dir r_dir_perms;
allow dynamicdata sysfs_dt_firmware_android:file r_file_perms;
allow dynamicdata metadata_file:dir search;
allow dynamicdata gsi_metadata_file_type:dir search;
allow dynamicdata gsi_public_metadata_file:file r_file_perms;

# ro.vendor.storage.dynamicdata comes from vendor build.prop.
set_prop(vendor_init, vendor_dynamicdata_prop)
